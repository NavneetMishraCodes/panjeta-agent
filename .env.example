# Panjeta Agent - example environment configuration
#
# Copy this file to `.env` and fill in real values there.
# Never commit your actual `.env` file or real secrets.
#
# Provider-specific variables will grow here as providers are added.
# OpenRouter is the first provider integrated.

# General application environment (e.g. development, production)
APP_ENV=development

# --- OpenRouter (OpenAI-compatible API) ---
# Get a key at https://openrouter.ai/keys - never commit a real value.
OPENROUTER_API_KEY=
# Model identifier as listed on https://openrouter.ai/models
OPENROUTER_MODEL=
