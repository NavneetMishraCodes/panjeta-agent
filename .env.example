# Panjeta Agent - example environment configuration
#
# Copy this file to `.env` and fill in real values there.
# Never commit your actual `.env` file or real secrets.
#
# No LLM provider has been chosen yet, so no provider-specific
# variables are defined here. This file will grow as that decision
# is made and as new configuration needs appear.

# General application environment (e.g. development, production)
APP_ENV=development

# Placeholder for a future LLM provider API key.
# LLM_API_KEY=your-api-key-here
