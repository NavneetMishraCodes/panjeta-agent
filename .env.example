# Panjeta Agent - example environment configuration
#
# Copy this file to `.env` and fill in real values there.
# Never commit your actual `.env` file or real secrets.
#
# Two LLM providers are supported: OpenRouter and Google Gemini.
# The interactive entry point (python -m src.main) selects one of them.

# General application environment (e.g. development, production)
APP_ENV=development

# --- Provider selection for the interactive entry point ---
# Values: openrouter | google. Optional; defaults to openrouter.
# Can be overridden per run with: python -m src.main --provider google
# PANJETA_LLM_PROVIDER=openrouter

# --- OpenRouter (OpenAI-compatible API) ---
# Get a key at https://openrouter.ai/keys - never commit a real value.
# Used by the "openrouter" provider.
OPENROUTER_API_KEY=
# Model identifier as listed on https://openrouter.ai/models
OPENROUTER_MODEL=

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/apikey - never commit a real value.
# Used by the "google" provider. This is the same var the official SDK uses.
GOOGLE_API_KEY=
# Model identifier as listed on https://ai.google.dev/gemini-api/docs/models
# e.g. gemini-2.0-flash
GOOGLE_MODEL=

# --- Panjeta filesystem sandbox ---
# Every file-manager tool (list_directory, read_file, create_file, copy_file,
# move_file, rename_file, delete_file, create_directory, delete_directory,
# move_directory) operates strictly inside this root.
# Optional. When unset, Panjeta uses a safe documented default:
#   <project folder>/panjeta_files
# Relative tool paths are resolved against this root; absolute paths are
# accepted only when they resolve inside it. `..` and symlink escapes are
# always rejected.
# PANJETA_FILE_ROOT=C:\Users\me\PanjetaFiles

# --- Persistent session state ---
# Where the interactive conversation is stored between launches. Optional.
# Default when unset: <project folder>/data/session.json (data/ is
# gitignored). The session stores ONLY bounded message history - never API
# keys, .env contents, or file contents read by tools.
# PANJETA_SESSION_FILE=C:\Users\me\panjeta-session.json
